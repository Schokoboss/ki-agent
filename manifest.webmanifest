{
  "id": "/ki-agent/",
  "name": "Nova – KI-Agent",
  "short_name": "Nova",
  "description": "Dein persönlicher KI-Agent – auf deinem Laptop und direkt auf dem Handy.",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone"],
  "orientation": "portrait",
  "background_color": "#0e0f13",
  "theme_color": "#0e0f13",
  "categories": ["productivity", "utilities"],
  "launch_handler": { "client_mode": "focus-existing" },
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/badge-96.png", "sizes": "96x96", "type": "image/png", "purpose": "monochrome" }
  ],
  "shortcuts": [
    { "name": "Neuer Chat", "short_name": "Neuer Chat", "url": "./?new=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Auftrag starten", "short_name": "Auftrag", "url": "./?work=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Foto fragen", "short_name": "Foto", "url": "./?photo=1",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Laptop-Bildschirm zeigen", "short_name": "Bildschirm", "url": "./?ask=screen",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["image/*", "application/pdf", "text/*", ".txt", ".csv", ".json", ".zip", "*/*"] }]
    }
  }
}
