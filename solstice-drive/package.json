{
  "name": "solstice-drive",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SOLSTICE DRIVE – Open-World-Arcade-Rennspiel auf Kap Aurora (Browser, optimiert für Google Pixel 10a)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
