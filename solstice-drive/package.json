    "typen": "tsc --noEmit",
    "server": "tsx server/index.ts",
    "icons": "tsx werkzeuge/icons-bauen.ts",
    "karte": "tsx werkzeuge/karte-rendern.ts",
    "balance": "tsx werkzeuge/balance.ts",
    "fahrtest": "node werkzeuge/fahrtest.mjs",
    "messung": "node werkzeuge/fps-messung.mjs"
  },
  "dependencies": {
    "three": "0.187.0",
    "ws": "8.22.2"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "0.187.0",
    "@types/ws": "^8.18.0",
    "tsx": "^4.20.0",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^5.1.0"
  }
